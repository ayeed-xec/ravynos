/.idea
/.vscode
ravynOS.xcodeproj
/build.log
.DS_Store
target/

# Everything under build/ is generated output except the tracked build
# logic: build/ci (gate scripts), build/mig sources (build.sh, patches,
# tests, include shim) and build/boot sources (UEFI loader, testkernel,
# mkfat, run scripts). mig's bin/libexec/work and boot's build/ are
# generated by their build scripts.
/build/*
!/build/ci/
!/build/mig/
/build/mig/bin/
/build/mig/libexec/
/build/mig/work/
!/build/boot/
/build/boot/build/
