/.idea
/.vscode
ravynOS.xcodeproj
/build.log
.DS_Store
target/

# Everything under build/ is generated output except the tracked build
# logic: build/ci (gate scripts) and build/mig sources (build.sh, patches,
# tests, include shim). mig's bin/libexec/work are generated by build.sh.
/build/*
!/build/ci/
!/build/mig/
/build/mig/bin/
/build/mig/libexec/
/build/mig/work/
