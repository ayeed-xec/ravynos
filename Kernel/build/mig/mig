#!/bin/sh
# mig driver for Linux: preprocessor pass + migcom, mirroring Apple's mig.sh.
# Usage: mig [cpp-flags] [-user f] [-server f] [-header f] [-sheader f] file.defs
set -e
HERE=$(cd "$(dirname "$0")" && pwd)
XNU=${XNU_TREE:-$HERE/../../xnu}
SHIM=$HERE/shim
MIGCOM=$HERE/bin/migcom

DEFS=""
CPPARGS=""
OUTARGS=""
while [ $# -gt 0 ]; do
  case "$1" in
    -user|-server|-header|-sheader|-iheader|-dheader|-maxonstack)
      OUTARGS="$OUTARGS $1 $2"; shift 2;;
    -user.*|-server.*|-header.*|-sheader.*|-iheader.*|-dheader.*)
      OUTARGS="$OUTARGS $1"; shift;;
    -*)
      if [ -z "$DEFS" ]; then CPPARGS="$CPPARGS $1"; else OUTARGS="$OUTARGS $1"; fi; shift;;
    *)
      DEFS="$1"; shift;;
  esac
done
[ -n "$DEFS" ] || { echo "mig: no .defs file" >&2; exit 1; }
[ -x "$MIGCOM" ] || { echo "mig: run $HERE/build.sh first" >&2; exit 1; }

T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT
(echo "#line 1 \"$DEFS\""; cat "$DEFS") > "$T/in.c"
clang -E -std=gnu17 -D__MACH30__ -D__MIG__ -Ulinux \
  -I"$(dirname "$DEFS")" -I"$SHIM" -I"$XNU/osfmk" -I"$XNU/libkern" \
  -include "$SHIM/mach_decl_shim.h" \
  $CPPARGS "$T/in.c" 2>"$T/cpp.err" \
  | "$MIGCOM" $OUTARGS
