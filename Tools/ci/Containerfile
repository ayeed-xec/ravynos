# The gate image (SYSTEM-DESIGN.md 5.6, GAP-40). Every CI gate runs inside this
# image, so the compiler version is pinned by the digest of the base image and
# the explicit package versions below rather than by whatever the runner has
# (GAP-08).
ARG BASE=ubuntu:24.04
FROM ${BASE}

ENV DEBIAN_FRONTEND=noninteractive

# Toolchain: clang/lld/llvm for the builds, byacc for mig's parser, ninja for
# rv's output, QEMU with firmware for the boot smokes, and shellcheck/git for
# the gates. No GCC, binutils, bison, flex or GNU make (ADR-17, ADR-24).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        clang-18 clang-format-18 lld-18 llvm-18 llvm-18-tools \
        cargo rustc rustfmt \
        byacc ninja-build cmake \
        qemu-system-x86 qemu-system-arm qemu-system-misc \
        ovmf qemu-efi-aarch64 opensbi \
        git curl ca-certificates python3 shellcheck file \
 && rm -rf /var/lib/apt/lists/*

# The unversioned names are what rv and the scripts invoke.
RUN for tool in clang clang++ clang-format ld.lld llvm-ar llvm-nm llvm-objcopy llvm-strip; do \
        target="/usr/local/bin/${tool}"; src=$(command -v "${tool}-18" || true); \
        if [ -n "${src}" ]; then ln -sfn "${src}" "${target}"; fi; \
    done \
 && clang --version && ld.lld --version && ninja --version

WORKDIR /src
