# Pinned upstream trees (SYSTEM-DESIGN.md S01, ADR-10).
#
# `rv vendors check` compares `git rev-parse HEAD:<path>` with `tree` and fails
# on any difference. A vendored tree is never edited: deltas live in the
# component's `patches` directory and are applied by rvpatch to a build copy.
# `prune` lists paths, relative to `path`, that are deliberately absent because
# the upstream tree ships generator output no license rule accepts (ADR-17).
# The pin covers the pruned tree; a listed path that reappears fails the check.
# `fetch = true` trees are downloaded to `build/vendor/<name>` and verified by
# `commit`; they are never committed, so they carry no `tree`.

[[vendor]]
name     = "xnu"
path     = "Kernel/xnu"
upstream = "https://github.com/apple-oss-distributions/xnu"
tag      = "xnu-12377.121.6"
commit   = "ac9718fb1af618d5ce8678d0dc6e8a58f252216f"
tree     = "c35cb043fc736ee3b03605433566b0008fb4d067"
license  = "APSL-2.0"
patches  = "Kernel/patches"
prune    = ["libkern/c++/OSUnserialize.cpp", "iokit/System/OSUnserializeXMLSharedImplementation.h", "libkern/libkern/c++/OSUnserializeXMLSharedImplementation.h"]

[[vendor]]
name     = "migcom"
path     = "Tools/mig/upstream"
upstream = "https://github.com/apple-oss-distributions/bootstrap_cmds"
tag      = "bootstrap_cmds-138"
commit   = "c71d2d72f48995baaea76148f61002e5299841de"
tree     = "7ab1533c050d5104f0ad64956a03bd640464b160"
license  = "Apache-2.0"
patches  = "Tools/mig/patches"
subdirs  = ["migcom.tproj"]
prune    = ["migcom.tproj/parser.c", "migcom.tproj/lexxer.c"]

[[vendor]]
name     = "llvm-project"
path     = "build/vendor/llvm-project"
upstream = "https://github.com/swiftlang/llvm-project"
tag      = "swift-6.4.3-RELEASE"
commit   = "fb5f84d903a3b4e7aea15cd5666598a46f56c833"
license  = "Apache-2.0"
fetch    = true
